# Set these privately in Vercel Project > Settings > Environment Variables.
# Connect Upstash Redis through Vercel Marketplace/Storage.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=
# Use a different prefix for Preview so it cannot share production sessions/data.
STORE_REDIS_PREFIX=comfortlane:production:
COMFYNEST_ADMIN_USERNAME=admin
COMFYNEST_ADMIN_PASSWORD=
# Optional canonical origin. Otherwise Vercel's deployment host is used.
COMFYNEST_BASE_URL=
